generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URI")
}

generator erd {
  provider = "prisma-erd-generator"
}

model User {
  id String @id @default(uuid())

  email    String @unique
  password String
  role     Role   @default(USER)

  name String

  favorites          Favorite[]
  completedProblems  CompletedProblem[]
  collections        Collection[]
  notes              Note[]
  questionProgresses QuestionProgress[]

  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  Interview Interview[]

  @@map("users")
}

model Problems {
  id String @id @default(uuid())

  title       String
  description String     @db.Text
  //category    Category
  difficulty  Difficulty
  tags        String[]
  solution    String?    @db.Text

  favorites          Favorite[]
  completedProblems  CompletedProblem[]
  collectionProblems CollectionProblem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("problems")
}

model Favorite {
  id String @id @default(uuid())

  userId    String
  problemId String

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problems @relation(fields: [problemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, problemId])
  @@map("favorites")
}

model CompletedProblem {
  id String @id @default(uuid())

  userId    String
  problemId String

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problems @relation(fields: [problemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, problemId])
  @@map("completed_problems")
}

model Collection {
  id     String @id @default(uuid())
  name   String
  userId String

  user     User                @relation(fields: [userId], references: [id])
  problems CollectionProblem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("collections")
}

model CollectionProblem {
  id String @id @default(uuid())

  collectionId String
  problemId    String

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  problem    Problems   @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([collectionId, problemId])
  @@map("collection_problems")
}

model Note {
  id String @id @default(uuid())

  title   String
  content String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notes")
}

model Interview {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  topic     String?
  questions Json    @default("[]")

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  messages Message[]
  report   InterviewReport?

  //currentIndex Int  @default(0)

  @@map("interviews")
}

model Message {
  id          String    @id @default(uuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id])

  role     RoleMessage
  text     String
  audioUrl String?

  createdAt DateTime @default(now())

  @@map("messages")
}

model InterviewReport {
  id          String    @id @default(uuid())
  interviewId String    @unique
  interview   Interview @relation(fields: [interviewId], references: [id])
  category    Category?

  score      Decimal
  feedback   String
  strengths  String[]
  weaknesses String[]

  createdAt DateTime @default(now())

  @@map("interview_reports")
}

model Topic {
  id String @id @default(uuid())

  name     String
  category Category

  parentId String?
  parent   Topic?  @relation("TopicTree", fields: [parentId], references: [id])
  children Topic[] @relation("TopicTree")

  order Int     @default(0)
  icon  String?

  questions Question[]
}

model Question {
  id String @id @default(uuid())

  question String  @db.Text
  answer   String? @db.Text

  category Category
  topicId  String
  topic    Topic    @relation(fields: [topicId], references: [id])

  order Int @default(0)

  createdAt DateTime @default(now())

  progresses QuestionProgress[]
}

model QuestionProgress {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  status QuestionLearningStatus

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, questionId])
}

enum RoleMessage {
  USER
  AI
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Category {
  FRONTEND
  BACKEND
  ALGORITHMS
  DATABASES
  DEVOPS
  SYSTEM_DESIGN
}

enum QuestionLearningStatus {
  LEARNED
  REVIEW
  HARD
}
